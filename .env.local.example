# Supabase / Next.js — переменные окружения (пример)

# Публичные (можно в браузере)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Канонический URL сайта (sitemap, robots, Open Graph, share)
NEXT_PUBLIC_SITE_URL=https://xbtex.ru

# ТОЛЬКО сервер (API orders/forms, seed, create-admin). НИКОГДА NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Опционально для npm run create-admin
# ADMIN_EMAIL=admin@vitex37.local
# ADMIN_PASSWORD=change-me-in-production
