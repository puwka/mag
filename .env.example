# Скопируйте в .env.local для локальной разработки.
# На Vercel задайте те же ключи в Project → Settings → Environment Variables.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Только сервер (API orders/forms). Не используйте префикс NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Опционально (локально: npm run create-admin)
# ADMIN_EMAIL=admin@yourdomain.ru
# ADMIN_PASSWORD=change-me-in-production
